{
  "name": "team-management",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run generate:api",
    "build": "tsc -b && vite build",
    "prebuild": "npm run generate:api",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:run": "vitest run",
    "pretest:run": "npm run generate:api",
    "test:e2e": "playwright test",
    "validate:api": "openapi-generator-cli validate -i specs/001-club-team-management/contracts/openapi.yaml",
    "generate:api": "openapi-generator-cli generate -i specs/001-club-team-management/contracts/openapi.yaml -g typescript-fetch -o src/generated/openapi --additional-properties=supportsES6=true,typescriptThreePlus=true,useSingleRequestParameter=true"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@openapitools/openapi-generator-cli": "2.42.2",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "28.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "5.1.1"
  }
}
